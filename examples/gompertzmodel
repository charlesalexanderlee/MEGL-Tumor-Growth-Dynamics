import numpy as np
import matplotlib.pyplot as plt
from scipy.integrate import solve_ivp

def risc(t, Y, gamma, Beta, alpha_i, alpha_s, alpha_c, Nu_i, Nu_s, Nu_c):
    r, i, s, c = Y
    
    r_safe = np.maximum(r, 1e-10)
    i_safe = np.maximum(i, 1e-10)
    s_safe = np.maximum(s, 1e-10)
    c_safe = np.maximum(c, 1e-10)

    drdt = gamma - (Beta * r_safe * i_safe)
    didt = (alpha_i * i_safe * np.log(Nu_i / i_safe)) - (Beta * r_safe * i_safe)
    dsdt = (Beta * r_safe * i_safe) + (alpha_s * s_safe * np.log(Nu_s / s_safe))
    dcdt = (alpha_c * c_safe * np.log(Nu_c / c_safe)) - (s_safe * c_safe)


    
    return [drdt, didt, dsdt, dcdt]

t_span = (0, 10)
y0 = [1e-5, 1.0, 1e-5, 0.5]  
t_eval = np.linspace(0, 10, 100)

Beta = 0.1
gamma = 1.5
alpha_i = 4.4
alpha_s = 0.3
alpha_c = 4.8
Nu_i = 4.0
Nu_s = 4.0
Nu_c = 4.0

sol = solve_ivp(
    risc, 
    t_span, 
    y0, 
    t_eval=t_eval, 
    args=(gamma, Beta, alpha_i, alpha_s, alpha_c, Nu_i, Nu_s, Nu_c),
    method='Radau' 
)

print("Success:", sol.success)

plt.figure(figsize=(10, 5))
plt.plot(sol.t, sol.y[0], label="r")
plt.plot(sol.t, sol.y[1], label="i")
plt.plot(sol.t, sol.y[2], label="s")
plt.plot(sol.t, sol.y[3], label="c")
plt.xlabel("Time t")
plt.ylabel("Density / Concentration")
plt.title("Gompertz RISC Model Simulation")
plt.grid(True)
plt.legend()
plt.show()
